{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id339116218"}, "name":{"label":"VJBS802"}, "label":""}, "updated":{"label":"2026-08-27T11:59:21-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"1.0.1"}, "id":{"label":"14479247757"}, "title":{"label":"Love this!"}, "content":{"label":"I really, really love having one place to save all my favorite recipes! The personalized recipe recommendations are especially great — they save me hours of digging through websites and on social to find new recipes to fill out my weekly meal plan. 10/10!", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=6755009073&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
